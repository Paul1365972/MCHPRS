test_args "--passes=coalesce"

# Both torches read the same inputs. Merging them makes their repeaters identical too, and the
# lamp keeps the links of both
circuit @same_inputs_input {
  %lever_a = lever false
  %lever_b = lever false
  %repeater1 = repeater 1, false, false, false, [%torch1:0], []
  %repeater2 = repeater 1, false, false, false, [%torch2:5], []
  %torch1 = torch true, [%lever_a:3, %lever_b:0]
  %torch2 = torch true, [%lever_a:0, %lever_b:7]
  %lamp = lamp false, [%repeater1:0, %repeater2:4]
}

test(@same_inputs_input) circuit @same_inputs {
  %lever_a = lever false
  %lever_b = lever false
  %repeater1 = repeater 1, false, false, false, [%torch1:0], []
  %torch1 = torch true, [%lever_a:3, %lever_b:0]
  %lamp = lamp false, [%repeater1:0, %repeater1:4]
}

# The loop ticks first, so the reader already sees its new output
circuit @self_loop_input {
  %lever = lever true
  %loop = comparator compare, none, false, 15, [%lever:0, %loop:1], []
  %reader = comparator compare, none, false, 15, [%lever:0, %loop:1], []
  %lamp_loop = lamp true, [%loop:0]
  %lamp_reader = lamp true, [%reader:0]
}

test(@self_loop_input) circuit @self_loop {
  %lever = lever true
  %loop = comparator compare, none, false, 15, [%lever:0, %loop:1], []
  %reader = comparator compare, none, false, 15, [%lever:0, %loop:1], []
  %lamp_loop = lamp true, [%loop:0]
  %lamp_reader = lamp true, [%reader:0]
}

# The middle torch ticks between the other two, so they see different values
circuit @input_ticks_between_input {
  %lever = lever true
  %torch_a = torch false, [%lever:0, %torch_x:0]
  %torch_x = torch false, [%lever:0]
  %torch_b = torch false, [%lever:0, %torch_x:0]
  %lamp_a = lamp false, [%torch_a:0]
  %lamp_b = lamp false, [%torch_b:0]
}

test(@input_ticks_between_input) circuit @input_ticks_between {
  %lever = lever true
  %torch_a = torch false, [%lever:0, %torch_x:0]
  %torch_x = torch false, [%lever:0]
  %torch_b = torch false, [%lever:0, %torch_x:0]
  %lamp_a = lamp false, [%torch_a:0]
  %lamp_b = lamp false, [%torch_b:0]
}

# Each comparator sees the other's change in the same tick, so no order of the two matches a
# merged node
circuit @mutual_loop_input {
  %lever = lever false
  %comparator_a = comparator compare, none, false, 0, [%lever:0, %comparator_a:1, %comparator_b:1], []
  %comparator_b = comparator compare, none, false, 0, [%lever:0, %comparator_a:1, %comparator_b:1], []
  %lamp_a = lamp false, [%comparator_a:0]
  %lamp_b = lamp false, [%comparator_b:0]
}

test(@mutual_loop_input) circuit @mutual_loop {
  %lever = lever false
  %comparator_a = comparator compare, none, false, 0, [%lever:0, %comparator_a:1, %comparator_b:1], []
  %comparator_b = comparator compare, none, false, 0, [%lever:0, %comparator_a:1, %comparator_b:1], []
  %lamp_a = lamp false, [%comparator_a:0]
  %lamp_b = lamp false, [%comparator_b:0]
}

# A comparator reads the signal strength, so the weight must match
circuit @analog_reader_input {
  %lever = lever false
  %comparator1 = comparator compare, none, false, 0, [%lever:0], []
  %comparator2 = comparator compare, none, false, 0, [%lever:5], []
  %lamp1 = lamp false, [%comparator1:0]
  %lamp2 = lamp false, [%comparator2:0]
}

test(@analog_reader_input) circuit @analog_reader {
  %lever = lever false
  %comparator1 = comparator compare, none, false, 0, [%lever:0], []
  %comparator2 = comparator compare, none, false, 0, [%lever:5], []
  %lamp1 = lamp false, [%comparator1:0]
  %lamp2 = lamp false, [%comparator2:0]
}

# Both cells output 1 while the lever is off and 0 while it is on, so they merge whatever their
# modes and link weights. The third outputs 2 and 1, so it stays.
circuit @comparator_outputs_input {
  %lever = lever false
  %one = constant 1
  %two = constant 2
  %cell1 = comparator subtract, none, false, 1, [%one:0], [%lever:2]
  %cell2 = comparator compare, none, false, 1, [%one:0], [%lever:9]
  %cell3 = comparator subtract, none, false, 2, [%two:0], [%lever:14]
  %lamp1 = lamp true, [%cell1:0, %cell3:0]
  %lamp2 = lamp true, [%cell2:3]
}

test(@comparator_outputs_input) circuit @comparator_outputs {
  %lever = lever false
  %one = constant 1
  %two = constant 2
  %cell1 = comparator subtract, none, false, 1, [%one:0], [%lever:2]
  %cell3 = comparator subtract, none, false, 2, [%two:0], [%lever:14]
  %lamp1 = lamp true, [%cell1:0, %cell3:0]
  %lamp2 = lamp true, [%cell1:3]
}
