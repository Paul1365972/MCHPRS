test_args "--passes=unreachable-output"

# %sub outputs at most 3, so the loop through %loop cannot exceed 3 either
circuit @bounded_loop_input {
  %button = button false -> [%sub:0]
  %constant = constant 12 -> [side %sub:0]
  %sub = comparator subtract, none, false, 0 -> [%loop:0, %lamp_sub:3]
  %loop = comparator compare, none, false, 0 -> [%loop:1, %lamp_near:2, %lamp_far:3]
  %lamp_sub = lamp false
  %lamp_near = lamp false
  %lamp_far = lamp false
}

test(@bounded_loop_input) circuit @bounded_loop {
  %button = button false -> [%sub:0]
  %constant = constant 12 -> [side %sub:0]
  %sub = comparator subtract, none, false, 0 -> [%loop:0]
  %loop = comparator compare, none, false, 0 -> [%loop:1, %lamp_near:2]
  %lamp_sub = lamp false
  %lamp_near = lamp false
  %lamp_far = lamp false
}

# The current output stays reachable even if the inputs can no longer produce it
circuit @current_output_input {
  %constant = constant 0 -> [%cmp:0]
  %cmp = comparator compare, none, false, 9 -> [%lamp_near:8, %lamp_far:9]
  %lamp_near = lamp false
  %lamp_far = lamp false
}

test(@current_output_input) circuit @current_output {
  %constant = constant 0
  %cmp = comparator compare, none, false, 9 -> [%lamp_near:8]
  %lamp_near = lamp false
  %lamp_far = lamp false
}

# A repeater whose side input is never off keeps its output, locked or not
circuit @locked_repeater_input {
  %lever = lever false -> [%locked:0, %unlocked:0]
  %constant = constant 15 -> [side %locked:0, side %unlocked:0]
  %locked = repeater 1, false, true, false -> [%lamp_locked:0]
  %unlocked = repeater 1, false, false, false -> [%lamp_unlocked:14]
  %lamp_locked = lamp false
  %lamp_unlocked = lamp false
}

test(@locked_repeater_input) circuit @locked_repeater {
  %lever = lever false -> [%locked:0, %unlocked:0]
  %constant = constant 15 -> [side %locked:0, side %unlocked:0]
  %locked = repeater 1, false, true, false
  %unlocked = repeater 1, false, false, false
  %lamp_locked = lamp false
  %lamp_unlocked = lamp false
}
