# The pins and their I/O standard as in Digilent's master XDC for the Basys 3.
set_property LOC W5 [get_ports clock]
set_property IOSTANDARD LVCMOS33 [get_ports clock]
set_property LOC B18 [get_ports serial_receive]
set_property IOSTANDARD LVCMOS33 [get_ports serial_receive]
set_property LOC A18 [get_ports serial_transmit]
set_property IOSTANDARD LVCMOS33 [get_ports serial_transmit]
set_property LOC W7 [get_ports {segment_n[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segment_n[0]}]
set_property LOC W6 [get_ports {segment_n[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segment_n[1]}]
set_property LOC U8 [get_ports {segment_n[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segment_n[2]}]
set_property LOC V8 [get_ports {segment_n[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segment_n[3]}]
set_property LOC U5 [get_ports {segment_n[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segment_n[4]}]
set_property LOC V5 [get_ports {segment_n[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segment_n[5]}]
set_property LOC U7 [get_ports {segment_n[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segment_n[6]}]
set_property LOC V7 [get_ports decimal_point_n]
set_property IOSTANDARD LVCMOS33 [get_ports decimal_point_n]
set_property LOC U2 [get_ports {anode_n[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {anode_n[0]}]
set_property LOC U4 [get_ports {anode_n[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {anode_n[1]}]
set_property LOC V4 [get_ports {anode_n[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {anode_n[2]}]
set_property LOC W4 [get_ports {anode_n[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {anode_n[3]}]
