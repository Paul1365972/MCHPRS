circuit @repeaters {
  %lever = lever -> [%delay_1:0, %delay_2:0, %delay_3:0, %delay_4:0, %lockable:0, %lockable_slow:0]
  %delay_1 = repeater(delay=1) -> [%out_1:0, %follower:0]
  %follower = repeater(delay=2) -> [%out_follower:0]
  %out_follower = trapdoor
  %delay_2 = repeater(delay=2) -> [%out_2:0]
  %delay_3 = repeater(delay=3) -> [%out_3:0]
  %delay_4 = repeater(delay=4) -> [%out_4:0, %chained:0]
  %chained = repeater(delay=1) -> [%out_chained:0]
  %out_1 = trapdoor
  %out_2 = trapdoor
  %out_3 = trapdoor
  %out_4 = trapdoor
  %out_chained = trapdoor

  %side_lever = lever -> [%lock:0, side %lockable_now:0]
  %lock = repeater(delay=1) -> [side %lockable:0, side %lockable_slow:0]
  %lockable = repeater(delay=1) -> [%out_lockable:0]
  %lockable_slow = repeater(delay=3) -> [%out_lockable_slow:0]
  %lockable_now = repeater(delay=2) -> [%out_lockable_now:0]
  %out_lockable = trapdoor
  %out_lockable_slow = trapdoor
  %out_lockable_now = trapdoor
  %lever_now = lever -> [%lockable_now:0]

  %supply = constant(power=15) -> [%turning_on:0, side %latched:0, %latched:0, side %held:2]
  %turning_on = repeater(delay=2) tick(delay=1, priority=high, order=0) -> [%out_turning_on:0]
  %out_turning_on = trapdoor
  %turning_off = repeater(delay=3, powered) tick(delay=2, priority=higher) -> [%out_turning_off:0]
  %out_turning_off = trapdoor(powered)
  %ending = repeater(delay=4, powered) tick(delay=4, priority=higher) -> [%out_ending:0]
  %out_ending = trapdoor(powered)
  %latched = repeater(delay=1, locked) tick(delay=1, priority=high, order=1) -> [%out_latched:0]
  %out_latched = trapdoor
  %held = repeater(delay=2, locked, powered) -> [%out_held:0]
  %out_held = trapdoor(powered)
}
